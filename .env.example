# Copy to .env. Never commit .env.
APP_NAME=z-procure
APP_TITLE=Z-Procure
DEMO_MODE=true

DATABASE_URL=postgresql+psycopg://procure:procure@localhost:5432/procure
TEST_DATABASE_URL=postgresql+psycopg://procure:procure@localhost:5432/procure_test

# Long random string; used to sign session JWTs.
JWT_SECRET=change-me-to-a-long-random-string

# LLM: "mock" (default, no key needed) or "gemini".
LLM_PROVIDER=mock
GEMINI_API_KEY=
# Pick current IDs from https://ai.google.dev/gemini-api/docs/models
GEMINI_PARSE_MODEL=
GEMINI_WRITE_MODEL=

STORAGE_DIR=storage
FRONTEND_ORIGIN=http://localhost:3000
